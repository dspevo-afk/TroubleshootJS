+class RecycledFrontendSession(MetricsSession):
+    """Synthetic CDP session whose frontend IDs change while backend scope stays fixed."""
+
+    def __init__(self, page=None, *, observer=None, fault=None, report=None):
+        super().__init__(fault, observer)
+        self.page = page or getattr(observer, "page", None)
+        self.frame_id = self.target_id = "frame"
+        self.target_url = URL
+        self.listeners = {}
+        self.document_reads = 0
+        self.last_document_id = self.last_html_id = None
+        self.report = report
+
+    def on(self, event, handler):
+        self.listeners.setdefault(event, []).append(handler)
+
+    def remove_listener(self, event, handler):
+        handlers = self.listeners.get(event, [])
+        if handler in handlers:
+            handlers.remove(handler)
+        if not handlers:
+            self.listeners.pop(event, None)
+
+    def emit(self, event, value):
+        for handler in tuple(self.listeners.get(event, ())):
+            handler(value)
+
+    async def send(self, method, params=None):
+        params = params or {}
+        if method in ("Page.enable", "DOM.enable"):
+            self.calls.append((method, params))
+            return {}
+        if method == "Page.getFrameTree":
+            result = await super().send(method, params)
+            frame = result["frameTree"]["frame"]
+            if self.fault == "frame":
+                frame["id"] = "successor-frame"
+            elif self.fault == "loader":
+                frame["loaderId"] = "successor-loader"
+            return result
+        if method == "DOM.getDocument":
+            self.calls.append((method, params))
+            self.document_reads += 1
+            document_id = 2 + 10 * self.document_reads
+            html_id = document_id + 2
+            self.last_document_id, self.last_html_id = document_id, html_id
+            document_backend, html_backend = ((20, 40) if self.fault == "backend" else (2, 4))
+            if self.page is not None and self.page.navigated and self.document_reads == 3:
+                state = "PREPARED:synthetic"
+            elif self.page is not None:
+                state = self.page.attributes.get(ATTRIBUTE, "ATTACHED:synthetic")
+            else:
+                state = "PREPARED:synthetic"
+            attributes = [ATTRIBUTE, state]
+            report = self.page.attributes.get(REPORT_ATTRIBUTE) if self.page is not None else None
+            if report is not None:
+                attributes.extend((REPORT_ATTRIBUTE, report))
+            children = [] if self.fault == "missing-html" else [{
+                "nodeName": "HTML", "nodeId": html_id, "backendNodeId": html_backend,
+                "attributes": attributes}]
+            return {"root": {"nodeName": "#document", "nodeId": document_id,
+                "backendNodeId": document_backend, "documentURL": self.target_url,
+                "children": children}}
+        result = await super().send(method, params)
+        if method == "Performance.getMetrics" and self.metric_reads == 1 and self.observer is not None:
+            if self.fault == "version":
+                self.emit("DOM.documentUpdated", {})
+            elif self.fault == "session":
+                self.emit("close", {})
+            elif self.fault == "navigation":
+                self.observer.navigation_epoch += 1
+            elif self.fault == "attachment":
+                self.observer.script_attachment["generation"] += 1
+        return result
+
