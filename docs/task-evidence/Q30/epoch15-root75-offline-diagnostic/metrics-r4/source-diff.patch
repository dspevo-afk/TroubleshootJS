+class SyntheticRoute:
+    def __init__(self, page, *, publish_events=False):
+        self.page = page
+        self.publish_events = publish_events
+        self.actions = []
+        self.request = types.SimpleNamespace(frame=page.main_frame, resource_type="script")
+        observer = getattr(page, "observer", None)
+        self.old_html_id = getattr(observer, "html_id", None)
+        self.refreshed_html_id = None
+        self.count_after_stale = self.count_after_fresh = None
+        self.cached_state_after_binding = None
+        self.report_present_at_route_entry = None
+        self.report_after_terminal = None
+
+    async def continue_(self):
+        self.actions.append("continue")
+        if not self.publish_events:
+            return
+        observer, session = self.page.observer, self.page.session
+        self.report_present_at_route_entry = REPORT_ATTRIBUTE in self.page.attributes
+        if self.old_html_id is None:
+            self.old_html_id = session.last_html_id - 10
+        self.refreshed_html_id = session.last_html_id
+        self.cached_state_after_binding = observer.state
+        session.emit("DOM.attributeModified", {"nodeId": self.old_html_id,
+            "name": ATTRIBUTE, "value": "RUNNING:stale"})
+        self.count_after_stale = observer.event_count
+        self.page.attributes[ATTRIBUTE] = "RUNNING:synthetic"
+        session.emit("DOM.attributeModified", {"nodeId": self.refreshed_html_id,
+            "name": ATTRIBUTE, "value": "RUNNING:synthetic"})
+        if self.page.report is not None:
+            self.page.attributes[REPORT_ATTRIBUTE] = self.page.report
+        self.page.attributes[ATTRIBUTE] = STATE
+        self.report_after_terminal = self.page.attributes.get(REPORT_ATTRIBUTE)
+        session.emit("DOM.attributeModified", {"nodeId": self.refreshed_html_id,
+            "name": ATTRIBUTE, "value": STATE})
+        self.count_after_fresh = observer.event_count
+        session.emit("DOM.attributeModified", {"nodeId": self.old_html_id,
+            "name": ATTRIBUTE, "value": "SCREEN_DONE:stale"})
+
+    async def abort(self):
+        self.actions.append("abort")
+
