+class SyntheticPage:
+    """Small fake Playwright surface; it does not start a browser or server."""
+
+    def __init__(self, report=None):
+        self.url = "about:blank"
+        self.main_frame = object()
+        self.navigated = False
+        self.attributes = {ATTRIBUTE: "ATTACHED:synthetic"}
+        self.report = report
+        self.listeners = {}
+        self.observer = None
+        self.route_handler = None
+        self.route_instance = None
+        self.session = RecycledFrontendSession(self, report=report)
+
+        class Context:
+            async def new_cdp_session(_context, _page):
+                return self.session
+        self.context = Context()
+
+    async def route(self, _pattern, handler):
+        self.route_handler = handler
+        self.observer = handler.__self__
+
+    async def unroute(self, _pattern, _handler):
+        return None
+
+    def on(self, event, handler):
+        self.listeners.setdefault(event, []).append(handler)
+
+    def remove_listener(self, event, handler):
+        handlers = self.listeners.get(event, [])
+        if handler in handlers:
+            handlers.remove(handler)
+        if not handlers:
+            self.listeners.pop(event, None)
+
+    async def goto(self, url, **_kwargs):
+        self.url, self.session.target_url, self.navigated = url, url, True
+        self.session.emit("Page.frameNavigated", {"frame": {"id": "frame", "url": url}})
+        await self.observer.html_ready.wait()
+        self.route_instance = SyntheticRoute(self, publish_events=True)
+        await self.route_handler(self.route_instance)
+        return types.SimpleNamespace(status=200, url=url, status_text="OK")
+
+    def locator(self, _selector):
+        page = self
+        class Locator:
+            async def get_attribute(_locator, attribute, timeout=None):
+                return page.attributes.get(attribute)
+        return Locator()
