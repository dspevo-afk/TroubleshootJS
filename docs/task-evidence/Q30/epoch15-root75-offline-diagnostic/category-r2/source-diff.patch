+def category_preflight(response):
+    """Match literal category atoms, including explicitly advertised groups."""
+    row = {"status": "INVALID_RESPONSE", "requiredCategories": list(CATEGORIES),
+           "returnedCategories": None, "returnedEvidenceComplete": False,
+           "missingRequirements": None, "matches": [], "errors": []}
+    categories = response.get("categories") if type(response) is dict else None
+    row["returnedType"] = type(categories).__name__
+    if type(response) is not dict or "categories" not in response or type(categories) is not list:
+        row["errors"].append("Tracing.getCategories must return categories as an array of strings")
+        return row
+    row["returnedCount"] = len(categories)
+    if len(categories) > MAX_CATEGORY_ENTRIES:
+        row["errors"].append("category entry count exceeds explicit bound")
+        return row
+    size = 0
+    for index, value in enumerate(categories):
+        if type(value) is not str:
+            row["errors"].append("category entry %d is not a string" % index)
+            return row
+        try:
+            encoded = value.encode("utf-8")
+        except UnicodeEncodeError:
+            row["errors"].append("category entry %d is not valid UTF-8" % index)
+            return row
+        size += len(encoded)
+        if len(encoded) > MAX_CATEGORY_ENTRY_BYTES or size > MAX_CATEGORY_BYTES:
+            row["errors"].append("category byte bound exceeded at entry %d" % index)
+            return row
+    # Preserve original order/duplicates/spelling before any membership decision.
+    row["returnedCategories"] = list(categories)
+    row["returnedEvidenceComplete"] = True
+    row["returnedUtf8Bytes"] = size
+    row["returnedCategoriesJsonSha256"] = hashlib.sha256(
+        json.dumps(categories, ensure_ascii=True, separators=(",", ":")).encode()).hexdigest()
+    atoms = [value.split(",") for value in categories]
+    if any(not token for group in atoms for token in group):
+        row["errors"].append("empty category/group atom; requirement membership unknown")
+        return row
+    missing = []
+    for required in CATEGORIES:
+        witness = next((index for index, group in enumerate(atoms) if required in group), None)
+        if witness is None:
+            missing.append(required)
+        else:
+            row["matches"].append({"requiredCategory": required, "returnedEntryIndex": witness,
+                                   "matchKind": "EXACT" if categories[witness] == required else "GROUP_ATOM"})
+    row["missingRequirements"] = missing
+    row["status"] = "MISSING_REQUIREMENTS" if missing else "REQUIREMENTS_ENUMERATED"
+    return row
 
 
