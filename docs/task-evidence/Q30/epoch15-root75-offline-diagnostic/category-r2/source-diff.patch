+class CategoryLifecycleChecks(unittest.IsolatedAsyncioTestCase):
+    async def test_missing_saved_before_fail_closed(self):
+        class MissingGC(Session):
+            async def send(self, method, params):
+                if method == "Tracing.getCategories":
+                    self.calls.append((method, params))
+                    return {"categories": ["devtools.timeline", "v8", "v8.execute", "toplevel"]}
+                return await super().send(method, params)
+        root = ROOT / self._testMethodName
+        root.mkdir()
+        session = MissingGC()
+        item = capture.RendererCapture(session, root, binding={"pageUrl": URL})
+        with self.assertRaisesRegex(ValueError, "MISSING_REQUIREMENTS: disabled-by-default-v8.gc"):
+            await item.start(time.monotonic() + 1)
+        receipt = json.loads((root / "renderer-category-preflight.json").read_text())
+        self.assertEqual(receipt["categoryPreflight"]["returnedCategories"],
+                         ["devtools.timeline", "v8", "v8.execute", "toplevel"])
+        self.assertEqual(receipt["categoryPreflight"]["missingRequirements"], ["disabled-by-default-v8.gc"])
+        self.assertNotIn("Performance.enable", [row[0] for row in session.calls])
+        self.assertNotIn("Tracing.start", [row[0] for row in session.calls])
+        result = await item.finish()
+        self.assertEqual(result["status"], "FAIL_CAPTURE")
+        self.assertEqual(result["categoryPreflight"], receipt["categoryPreflight"])
+        self.assertEqual(session.listeners, {})
+
