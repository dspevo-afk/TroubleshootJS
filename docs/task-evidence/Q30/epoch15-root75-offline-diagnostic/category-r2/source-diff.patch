+class CategoryChecks(unittest.TestCase):
+    # Independent required contract and primary-source group fixtures, rather
+    # than deriving expected membership from the implementation under test.
+    required = ["devtools.timeline", "v8", "v8.execute", "toplevel", "disabled-by-default-v8.gc"]
+    grouped = ["devtools.timeline,v8", "v8.execute,toplevel", "disabled-by-default-v8.gc"]
+
+    def test_exact_preserves_order_duplicates(self):
+        values = ["unrelated", "v8", "devtools.timeline", "v8.execute", "toplevel",
+                  "disabled-by-default-v8.gc", "v8"]
+        row = capture.category_preflight({"categories": values})
+        self.assertEqual(row["status"], "REQUIREMENTS_ENUMERATED")
+        self.assertEqual(row["requiredCategories"], self.required)
+        self.assertEqual(row["returnedCategories"], values)
+        self.assertTrue(row["returnedEvidenceComplete"])
+        self.assertEqual(row["missingRequirements"], [])
+        self.assertTrue(all(item["matchKind"] == "EXACT" for item in row["matches"]))
+
+    def test_explicit_comma_groups(self):
+        row = capture.category_preflight({"categories": self.grouped})
+        self.assertEqual(row["status"], "REQUIREMENTS_ENUMERATED")
+        self.assertEqual(row["returnedCategories"], self.grouped)
+        self.assertEqual([item["returnedEntryIndex"] for item in row["matches"]], [0, 0, 1, 1, 2])
+        self.assertEqual(row["matches"][0]["matchKind"], "GROUP_ATOM")
+
+    def test_each_requirement_stays_required(self):
+        for required in self.required:
+            with self.subTest(required=required):
+                values = [value for value in self.required if value != required]
+                row = capture.category_preflight({"categories": values})
+                self.assertEqual(row["status"], "MISSING_REQUIREMENTS")
+                self.assertEqual(row["missingRequirements"], [required])
+                self.assertEqual(row["returnedCategories"], values)
+
+    def test_no_alias_case_substring_or_wildcard_support(self):
+        values = ["DEVTOOLS.TIMELINE", "v8*", "v8.execute.more", "toplevel.flow",
+                  "disabled-by-default-v8.gc_extra"]
+        row = capture.category_preflight({"categories": values})
+        self.assertEqual(row["status"], "MISSING_REQUIREMENTS")
+        self.assertEqual(row["missingRequirements"], self.required)
+
+    def test_no_whitespace_normalization(self):
+        row = capture.category_preflight({"categories": ["devtools.timeline, v8",
+            "v8.execute,toplevel", "disabled-by-default-v8.gc"]})
+        self.assertEqual(row["missingRequirements"], ["v8"])
+
+    def test_empty_list_explains_all_missing(self):
+        row = capture.category_preflight({"categories": []})
+        self.assertEqual(row["missingRequirements"], self.required)
+        self.assertEqual(row["returnedCategories"], [])
+        self.assertTrue(row["returnedEvidenceComplete"])
+
+    def test_malformed_response_is_unknown_membership(self):
+        for response in (None, [], {}, {"categories": None}, {"categories": "v8"},
+                         {"categories": [1]}, {"categories": [True]}):
+            with self.subTest(response=response):
+                row = capture.category_preflight(response)
+                self.assertEqual(row["status"], "INVALID_RESPONSE")
+                self.assertIsNone(row["missingRequirements"])
+                self.assertFalse(row["returnedEvidenceComplete"])
+                self.assertTrue(row["errors"])
+
+    def test_empty_group_retains_response_but_refuses_membership(self):
+        values = self.required + ["a,,b"]
+        row = capture.category_preflight({"categories": values})
+        self.assertEqual(row["status"], "INVALID_RESPONSE")
+        self.assertEqual(row["returnedCategories"], values)
+        self.assertIsNone(row["missingRequirements"])
+
+    def test_category_bounds(self):
+        cases = [["x"] * 4097, ["x" * 1025], ["x" * 1024] * 257,
+                 ["\u00e9" * 513]]
+        for values in cases:
+            with self.subTest(count=len(values)):
+                row = capture.category_preflight({"categories": values})
+                self.assertEqual(row["status"], "INVALID_RESPONSE")
+                self.assertFalse(row["returnedEvidenceComplete"])
+                self.assertIsNone(row["missingRequirements"])
+
+    def test_invalid_utf8_is_explained(self):
+        row = capture.category_preflight({"categories": ["\ud800"]})
+        self.assertEqual(row["status"], "INVALID_RESPONSE")
+        self.assertIn("not valid UTF-8", row["errors"][0])
