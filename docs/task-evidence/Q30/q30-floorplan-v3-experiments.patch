+    private static void inspectRootPlan(long seed, int candidate,
+            RootPlacementVariant variant) {
+        RootPlanManifest manifest = new RootPlanManifest(seed, variant);
+        PcbPlacementPlanner planner = new PcbPlacementPlanner(manifest.registry);
+        PcbPlacementPlanner.Plan plan = planner.plan(manifest.board,
+            manifest.board.getPlacementConstraints(), manifest.layoutSeed, candidate);
+        if (variant == RootPlacementVariant.MANUAL_CHANNELS ||
+                variant == RootPlacementVariant.COMPACT_MANUAL)
+            plan = manualChannelPlan(manifest, plan);
+        System.out.println("Q30_ROOT_INSPECT {\"seed\":\"" + seed +
+            "\",\"candidate\":" + candidate + "\",\"variant\":\"" +
+            variant + "\",\"outline\":\"" + rectangle(plan.outline) + "\"}");
+        for (PcbFootprint footprint : plan.footprints) {
+            PcbComponentPlacement placement = footprint.getPlacement();
+            System.out.println("Q30_ROOT_PART {\"id\":\"" +
+                placement.getComponentId() + "\",\"bounds\":\"" +
+                rectangle(placement.getBounds()) + "\",\"courtyard\":\"" +
+                rectangle(placement.getRoutingCourtyard()) + "\",\"pads\":\"" +
+                padSummary(footprint.getPads()) + "\"}");
+        }
+        for (String netId : manifest.board.getNetIds()) {
+            BoardNet net = manifest.board.getNet(netId);
+            int minX = Integer.MAX_VALUE, minY = Integer.MAX_VALUE;
+            int maxX = Integer.MIN_VALUE, maxY = Integer.MIN_VALUE;
+            StringBuilder pads = new StringBuilder();
+            for (String padId : net.getPadIds()) {
+                PcbPadPlacement pad = findPad(plan, padId);
+                minX = Math.min(minX, pad.getX()); minY = Math.min(minY, pad.getY());
+                maxX = Math.max(maxX, pad.getX()); maxY = Math.max(maxY, pad.getY());
+                if (pads.length() > 0) pads.append(',');
+                pads.append(padId).append('@').append(pad.getX()).append('/').append(pad.getY());
+            }
+            System.out.println("Q30_ROOT_NET {\"id\":\"" + netId +
+                "\",\"role\":\"" + net.getRoutingRole() + "\",\"pads\":\"" +
+                pads + "\",\"box\":\"" + minX + "," + minY + "," + maxX +
+                "," + maxY + "\"}");
+        }
+    }
+
+    private static PcbPadPlacement findPad(PcbPlacementPlanner.Plan plan,
+            String padId) {
+        for (PcbFootprint footprint : plan.footprints)
+            for (PcbPadPlacement pad : footprint.getPads())
+                if (pad.getPadId().equals(padId)) return pad;
+        throw new IllegalStateException("Missing layout pad " + padId);
+    }
+
+    private static String rectangle(Rectangle value) {
+        return value.x + "," + value.y + "," + value.width + "," + value.height;
+    }
+
+    private static String padSummary(Vector<PcbPadPlacement> pads) {
+        StringBuilder result = new StringBuilder();
+        for (PcbPadPlacement pad : pads) {
+            if (result.length() > 0) result.append(';');
+            result.append(pad.getPadId()).append('@').append(pad.getX()).append(',')
+                .append(pad.getY()).append(" escape=").append(pad.getEscapeDx())
+                .append(',').append(pad.getEscapeDy()).append(',')
+                .append(pad.getEscapeLength());
+        }
+        return result.toString();
+    }
