+    private static void manualDiagnostics(RootPlanManifest manifest,
+            Rectangle outline, Vector<PcbFootprint> placed) {
+        for (int i = 0; i < placed.size(); i++) {
+            PcbFootprint first = placed.get(i);
+            PcbPlacementConstraints.Part firstDemand = manifest.board
+                .getPlacementConstraints().get(first.getPlacement().getComponentId());
+            Rectangle firstEnvelope = PcbPlacementPlanner.envelope(first,
+                firstDemand.accessMargin);
+            if (firstEnvelope.x < outline.x + 10 || firstEnvelope.y < outline.y + 10 ||
+                    firstEnvelope.x + firstEnvelope.width > outline.x + outline.width - 10 ||
+                    firstEnvelope.y + firstEnvelope.height > outline.y + outline.height - 10)
+                System.out.println("Q30_MANUAL_DIAGNOSTIC outside=" +
+                    first.getPlacement().getComponentId() + " envelope=" +
+                    rectangle(firstEnvelope));
+            for (int j = i + 1; j < placed.size(); j++) {
+                PcbFootprint second = placed.get(j);
+                PcbPlacementConstraints.Part secondDemand = manifest.board
+                    .getPlacementConstraints().get(second.getPlacement().getComponentId());
+                Rectangle secondEnvelope = PcbPlacementPlanner.envelope(second,
+                    secondDemand.accessMargin);
+                if (firstEnvelope.intersects(secondEnvelope))
+                    System.out.println("Q30_MANUAL_DIAGNOSTIC overlap=" +
+                        first.getPlacement().getComponentId() + "/" +
+                        second.getPlacement().getComponentId() + " first=" +
+                        rectangle(firstEnvelope) + " second=" + rectangle(secondEnvelope));
+                for (PcbPadPlacement pad : first.getPads()) {
+                    int ex = pad.getX() + pad.getEscapeDx() * pad.getEscapeLength();
+                    int ey = pad.getY() + pad.getEscapeDy() * pad.getEscapeLength();
+                    if (second.getPlacement().getRoutingCourtyard().contains(ex, ey))
+                        System.out.println("Q30_MANUAL_DIAGNOSTIC escape=" +
+                            pad.getPadId() + " in=" + second.getPlacement().getComponentId());
+                }
+            }
+        }
+    }
