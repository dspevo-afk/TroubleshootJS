# Evidence hashes refer to these exact bytes, including mixed original line endings.
* -text whitespace=cr-at-eol
# Historical patches and raw verifier warnings retain their original whitespace.
*.patch whitespace=cr-at-eol,-blank-at-eol
p1-native-full-receipt.txt whitespace=cr-at-eol,-blank-at-eol
p1-native-full.log whitespace=cr-at-eol,-blank-at-eol
