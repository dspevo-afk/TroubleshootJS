+def _read_gwt_download_payload(repo, strong_name):
+    """Decode GWT's JSON-string array wrapper without executing its contents."""
+    bundle_path = repo / "war/circuitjs1" / (strong_name + ".cache.js")
+    bundle_bytes = bundle_path.read_bytes()
+    bundle_text = bundle_bytes.decode("utf-8-sig")
+    prefix = "circuitjs1.onScriptDownloaded("
+    if not bundle_text.startswith(prefix):
+        raise ValueError("cache bundle does not start with the expected GWT wrapper")
+    position = len(prefix)
+    while position < len(bundle_text) and bundle_text[position].isspace():
+        position += 1
+    if position >= len(bundle_text) or bundle_text[position] != "[":
+        raise ValueError("GWT wrapper payload is not a JSON array")
+    fragments, end = json.JSONDecoder().raw_decode(bundle_text, position)
+    if not isinstance(fragments, list) or not fragments or not all(
+            isinstance(fragment, str) for fragment in fragments):
+        raise ValueError("GWT wrapper array must contain non-empty string fragments")
+    if bundle_text[end:].strip() != ");":
+        raise ValueError("GWT wrapper has an unexpected suffix")
+    payload_text = "".join(fragments)
+    payload_bytes = payload_text.encode("utf-8")
+    embedded_names = re.findall(
+        r"\$strongName\s*=\s*['\"]([0-9A-Fa-f]{32})['\"]", payload_text)
+    if embedded_names != [strong_name]:
+        raise ValueError("decoded GWT payload strong name does not match its cache filename")
+    return {
+        "strongName": strong_name,
+        "cacheFileSha256": hashlib.sha256(bundle_bytes).hexdigest(),
+        "cacheFileBytes": len(bundle_bytes),
+        "payloadSha256": hashlib.sha256(payload_bytes).hexdigest(),
+        "payloadUtf8Bytes": len(payload_bytes),
+        "fragmentCount": len(fragments),
+        "embeddedStrongNameCount": len(embedded_names),
+        "wrapperValidated": True,
+    }, bundle_bytes, payload_bytes
+
+
+def capture_profile_script_provenance(repo, profile, cdp_session, script_events):
+    """Link sampled scriptIds only to exact GWT URLs or their decoded payload bytes."""
+    nodes_by_id = {node.get("id"): node for node in profile.get("nodes", [])}
+    sampled_script_ids = set()
+    for node_id in profile.get("samples", []):
+        node = nodes_by_id.get(node_id)
+        frame = node.get("callFrame", {}) if node else {}
+        script_id = str(frame.get("scriptId", ""))
+        if script_id not in ("", "0") and not _cpu_cache_name(
+                _safe_cpu_profile_path(frame.get("url", ""))):
+            sampled_script_ids.add(script_id)
+
+    strong_names = set()
+    for node in profile.get("nodes", []):
+        path = _safe_cpu_profile_path(node.get("callFrame", {}).get("url", ""))
+        strong = _cpu_cache_name(path)
+        if strong:
+            strong_names.add(strong)
+    for event in script_events.values():
+        strong = _cpu_cache_name(_safe_cpu_profile_path(event.get("url", "")))
+        if strong:
+            strong_names.add(strong)
+
+    bundles = {}
+    bundle_evidence = []
+    for strong in sorted(strong_names):
+        try:
+            metadata, file_bytes, payload_bytes = _read_gwt_download_payload(repo, strong)
+            bundles[strong] = (file_bytes, payload_bytes)
+            bundle_evidence.append(metadata)
+        except BaseException as error:
+            bundle_evidence.append({
+                "strongName": strong,
+                "wrapperValidated": False,
+                "error": type(error).__name__ + ": " + str(error),
+            })
+
+    script_map = {}
+    evidence_rows = []
+    for script_id in sorted(sampled_script_ids):
+        event = script_events.get(script_id, {})
+        event_url = _safe_cpu_profile_path(event.get("url", ""))
+        linked_names = set()
+        event_url_name = _cpu_cache_name(event_url)
+        if event_url_name:
+            linked_names.add(event_url_name)
+        stack_paths = []
+        for stack_frame in _walk_debugger_stack(event.get("stackTrace")):
+            path = _safe_cpu_profile_path(stack_frame.get("url", ""))
+            if path:
+                stack_paths.append(path)
+
+        source_text = None
+        source_error = None
+        try:
+            response = cdp_session.send("Debugger.getScriptSource", {
+                "scriptId": script_id})
+            value = response.get("scriptSource") if isinstance(response, dict) else None
+            if isinstance(value, str):
+                source_text = value
+            else:
+                source_error = "Debugger.getScriptSource returned no source text"
+        except BaseException as error:
+            source_error = type(error).__name__ + ": " + str(error)
+
+        source_sha256 = None
+        source_bytes = None
+        payload_matches = []
+        if source_text is not None:
+            source_bytes_value = source_text.encode("utf-8")
+            source_sha256 = hashlib.sha256(source_bytes_value).hexdigest()
+            source_bytes = len(source_bytes_value)
+            for strong, (file_bytes, payload_bytes) in sorted(bundles.items()):
+                match_kind = None
+                if source_bytes_value == file_bytes:
+                    match_kind = "exact-cache-file-bytes"
+                elif source_bytes_value == payload_bytes:
+                    match_kind = "exact-decoded-payload-bytes"
+                elif source_bytes >= 256 and source_bytes_value in payload_bytes:
+                    match_kind = "exact-decoded-payload-substring-256plus"
+                if match_kind:
+                    payload_matches.append({
+                        "strongName": strong,
+                        "match": match_kind,
+                        "scriptSourceSha256": source_sha256,
+                    })
+                    linked_names.add(strong)
+
+        unique_names = sorted(linked_names)
+        linked_strong = unique_names[0] if len(unique_names) == 1 else None
+        if linked_strong:
+            script_map[script_id] = linked_strong
+        evidence_rows.append({
+            "scriptId": script_id,
+            "debuggerScriptParsedObserved": bool(event),
+            "scriptParsedUrl": event_url,
+            "scriptParsedHash": event.get("hash") if isinstance(event.get("hash"), str) else None,
+            "scriptParsedStackPaths": sorted(set(stack_paths)),
+            "scriptSourceSha256": source_sha256,
+            "scriptSourceUtf8Bytes": source_bytes,
+            "scriptSourceError": source_error,
+            "decodedPayloadMatches": payload_matches,
+            "linkedStrongNames": unique_names,
+            "linkedStrongName": linked_strong,
+            "linkBasis": (
+                "exact-scriptParsed-cache-url" if event_url_name and linked_strong else
+                "exact-script-source-vs-decoded-payload" if len(payload_matches) == 1 and linked_strong else
+                "conflicting-exact-links" if len(unique_names) > 1 else "unlinked"),
+        })
+    return script_map, evidence_rows, bundle_evidence
+
