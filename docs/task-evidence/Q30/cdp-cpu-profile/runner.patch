+def _cpu_cache_name(path):
+    match = CPU_PROFILE_CACHE_RE.search(path or "")
+    return match.group(1).upper() if match else None
+
+
+def _safe_cpu_profile_path(raw_url):
+    """Return only an allowlisted local app path; accept sanitized paths on replay."""
+    parsed = urlsplit(raw_url or "")
+    path = parsed.path
+    local_http = (parsed.scheme in ("http", "https") and
+                  parsed.hostname in ("127.0.0.1", "localhost"))
+    already_sanitized = not parsed.scheme and not parsed.netloc
+    if ((local_http or already_sanitized) and
+            path.startswith(CPU_PROFILE_ALLOWED_PATHS)):
+        return path
+    return ""
+
+
+def _walk_debugger_stack(stack):
+    while isinstance(stack, dict):
+        for frame in stack.get("callFrames", []):
+            if isinstance(frame, dict):
+                yield frame
+        parent = stack.get("parent")
+        if not isinstance(parent, dict):
+            break
+        stack = parent
+
