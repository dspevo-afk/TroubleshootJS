+                cancelDuringEvaluation, failFinalization, null, null);
+        }
+
+        LiteralBackend(LiteralMetrics sourceMetrics, LiteralMetrics controlMetrics,
+                LiteralOutcome[][] cohorts, boolean throwDuringEvaluation,
+                boolean cancelDuringEvaluation, boolean failFinalization,
+                RuntimeException evaluationFailure,
+                RuntimeException finalizationFailure) {
+            this.sourceMetrics = sourceMetrics;
+            this.controlMetrics = controlMetrics;
+            this.cohorts = cohorts;
+            this.cancelDuringEvaluation = cancelDuringEvaluation;
+            this.evaluationFailure = evaluationFailure == null && throwDuringEvaluation ?
+                new IllegalStateException("literal unexpected evaluation") :
