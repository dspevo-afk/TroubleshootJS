+    private static void failureAndCancellationPropagation() {
+        LiteralMetrics source = literalMetrics(1000, 500, 4, 800);
+        LiteralMetrics control = literalMetrics(990, 500, 4, 790);
+        LiteralOutcome[][] cohort = new LiteralOutcome[][] {{
+            literalOutcome(literalMetrics(980, 500, 4, 780), true)
+        }};
+
+        final RuntimeException sentinel =
+            new IllegalStateException("literal unexpected evaluation");
+        final LiteralBackend unknown = new LiteralBackend(source, control, cohort,
+            false, false, false, sentinel, null);
+        boolean propagated = false;
+        try {
+            runDescent(unknown);
+        } catch (IllegalStateException expected) {
+            propagated = expected == sentinel;
+        }
+        check(propagated, "unknown evaluation failure propagates from the shared driver");
+
+        final GenerationJob job = new GenerationJob(new ScopeServices(),
+            100000L, 40, 5000L);
+        final LiteralBackend cancelled = new LiteralBackend(source, control, cohort,
+            false, true, false);
+        cancelled.job = job;
+        GenerationWorkScope.enter(job);
+        boolean cancellationPropagated = false;
+        try {
+            try {
+                runDescent(cancelled);
+            } catch (GenerationJob.Cancelled expected) {
+                cancellationPropagated = true;
+            }
+        } finally {
+            GenerationWorkScope.exit(job);
+        }
+        check(cancellationPropagated &&
+                job.getOutcome() == GenerationJob.Outcome.CANCELLED,
+            "actual cancellation during shared evaluation propagates and restores scope");
+
+        final RuntimeException finalizationSentinel =
+            new IllegalStateException("literal finalization failure");
+        final LiteralBackend failedFinalization = new LiteralBackend(source, control,
+            new LiteralOutcome[][] {new LiteralOutcome[0]},
+            false, false, false, null, finalizationSentinel);
+        boolean finalizationPropagated = false;
+        try {
+            runDescent(failedFinalization);
+        } catch (IllegalStateException expected) {
+            finalizationPropagated = expected == finalizationSentinel;
+        }
+        check(finalizationPropagated,
+            "final source verification failure propagates from the shared driver");
+        fixture("failureAndCancellationPropagation");
+    }
