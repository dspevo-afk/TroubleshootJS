+        public StructuralValue structural(Object frame) {
+            LiteralFrame value = (LiteralFrame) frame;
+            LiteralOutcome[] cohort = value.index < cohorts.length ?
+                cohorts[value.index] : new LiteralOutcome[0];
+            Vector<MoveValue> moves = new Vector<MoveValue>();
+            for (int index = 0; index < cohort.length; index++)
