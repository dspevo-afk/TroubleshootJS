+        public MetricValue metrics(Object frame, boolean initial) {
+            LiteralFrame value = (LiteralFrame) frame;
+            String metadata = value.privateFrame ? PRIVATE_GENERATION_METADATA :
+                SOURCE_GENERATION_METADATA;
+            return metricValue(value.metrics, metadata, value.index);
