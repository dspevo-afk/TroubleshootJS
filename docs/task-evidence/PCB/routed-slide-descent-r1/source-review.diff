+package com.lushprojects.circuitjs1.client;
+
+import java.util.Vector;
+
+/**
+ * Native-only bounded repeated private slide/compaction descent.  The selected
+ * route and the published board remain read-only; every accepted result is a
+ * private source for the next step.
+ */
+public final class PcbRoutedSlideDescentContractTest {
+    private static final int VERSION = 15;
+    private static final String PHASE = "SELECTED_AFTER_EDGE_TRIM";
+    private static final String SUMMARY_PREFIX =
+        "PCB_ROUTED_SLIDE_DESCENT_CASE ";
+    private static final String SOURCE_GENERATION_METADATA = "ACCEPTED_SELECTED";
+    private static final String PRIVATE_GENERATION_METADATA =
+        "UNASSIGNED_PRIVATE_CANDIDATE";
+    private static final int MAX_ACCEPTED_STEPS = 4;
+    private static final int MAX_EVALUATED_MOVES = 128;
+    private static int assertions;
+    private static int fixtures;
+
+    private PcbRoutedSlideDescentContractTest() { }
+
+    public static void main(String[] args) {
+        canonicalFirstImprovementAndTransitions();
+        strictDescentAndInitialGuards();
+        exhaustionAndEmptyCohort();
+        acceptedStepAndEvaluationCaps();
+        failureAndCancellationPropagation();
+        selectedObserverOwnershipAndAdapterIsolation();
+        check(fixtures == 6, "exactly six named selected-slide descent fixture groups");
+        System.out.println("PASS: PCB routed slide descent contracts assertions=" +
+            assertions + " fixtures=" + fixtures +
+            " evaluator=selectedRoutedSlideDescent");
+    }
+
+    /** The root wrapper calls this once for each fixed informed root. */
+    static void observe(long seed, String label) {
+        require(label != null && label.length() > 0,
+            "selected-slide descent label is present");
+        Recorder recorder = new Recorder(seed, label);
+        SeededPcbLayoutGenerator.SelectedSlideObserver previous =
+            SeededPcbLayoutGenerator.setSelectedSlideObserver(recorder);
+        String selectedReceipt;
+        try {
+            if (seed != 5L && seed != 2L)
+                throw new IllegalArgumentException(
+                    "Unexpected selected descent root: " + seed);
+            selectedReceipt =
+                PcbPostSelectionEdgeTrimContractTest.observeRoutedPassiveLegCensus(seed);
+        } finally {
+            SeededPcbLayoutGenerator.SelectedSlideObserver displaced =
+                SeededPcbLayoutGenerator.setSelectedSlideObserver(previous);
+            if (displaced != recorder)
+                throw new IllegalStateException(
+                    "Selected-slide descent observer owner changed");
+        }
+        require(recorder.callbacks == 1 && recorder.summary != null,
+            "selected root produced one complete descent callback");
+        require(selectedReceipt != null &&
+                selectedReceipt.startsWith("PCB_EDGE_TRIM_CASE {"),
+            "accepted15 helper returns its selected receipt");
+        System.out.println("PCB_ROUTED_LEG_CASE " +
+            selectedReceipt.substring("PCB_EDGE_TRIM_CASE ".length()));
+        System.out.println(recorder.summaryJson());
+    }
+
+    private static final class Recorder
+            implements SeededPcbLayoutGenerator.SelectedSlideObserver {
+        final long seed;
+        final String label;
+        int callbacks;
+        long startedNanos;
+        long finishedNanos;
+        String selectedRoute;
+        int selectedAttempt;
+        DescentRun result;
+        String summary;
+
+        Recorder(long seed, String label) {
+            this.seed = seed;
+            this.label = label;
+        }
+
+        public void onSelected(TroubleshootBoard board, PcbBoardLayout layout,
+                PcbPlacementPlanner.Plan plan, String route, int attempt) {
+            startedNanos = System.nanoTime();
+            try {
+                callbacks++;
+                require(callbacks == 1 && board != null && layout != null &&
+                        plan != null && route != null,
+                    "selected descent callback has a complete source frame");
+                require("P07_FULLER_TWO_LAYER".equals(route),
+                    "selected descent route is P07");
+                PcbRoutedSlideCompactionContractTest.verifySelectedFrameForDescent(
+                    seed, board, layout, plan, attempt);
+                selectedRoute = route;
+                selectedAttempt = attempt;
+                result = runDescent(new RuntimeBackend(seed, board, layout, plan));
+                summary = "ready";
+            } finally {
+                finishedNanos = System.nanoTime();
+            }
+        }
+
+        String summaryJson() {
+            require(summary != null && result != null,
+                "descent summary has a completed shared driver result");
+            StringBuilder json = new StringBuilder(300000);
+            json.append(SUMMARY_PREFIX).append('{');
+            json.append("\"seed\":"); stringField(json, Long.toString(seed));
+            json.append(",\"label\":"); stringField(json, label);
+            json.append(",\"version\":").append(VERSION);
+            json.append(",\"phase\":"); stringField(json, PHASE);
+            json.append(",\"status\":"); stringField(json, result.status);
+            json.append(",\"selectedAttempt\":").append(selectedAttempt);
+            json.append(",\"selectedRoute\":"); stringField(json, selectedRoute);
+            json.append(",\"newRouteRequests\":0");
+            json.append(",\"selectedMutation\":false");
+            json.append(",\"limits\":{\"maxAcceptedSteps\":")
+                .append(MAX_ACCEPTED_STEPS);
+            json.append(",\"maxEvaluatedMoves\":").append(MAX_EVALUATED_MOVES)
+                .append('}');
+            json.append(",\"source\":").append(result.sourceJson);
+            json.append(",\"sourceMetrics\":").append(result.sourceMetrics.json());
+            json.append(",\"initialControl\":")
+                .append(result.initialControl.controlJson());
+            json.append(",\"steps\":[");
+            for (int index = 0; index < result.steps.size(); index++) {
+                if (index != 0) json.append(',');
+                result.steps.get(index).appendJson(json);
+            }
+            json.append(']');
+            json.append(",\"finalMetrics\":").append(result.finalMetrics.json());
+            json.append(",\"aggregate\":{");
+            json.append("\"steps\":").append(result.steps.size());
+            json.append(",\"acceptedSteps\":").append(result.acceptedSteps);
+            json.append(",\"evaluatedMoves\":").append(result.evaluatedMoves);
+            json.append(",\"validatedMoves\":").append(result.validatedMoves);
+            json.append(",\"rejectedMoves\":").append(result.rejectedMoves);
+            json.append(",\"compactions\":").append(result.compactions);
+            json.append('}');
+            json.append(",\"elapsedMillis\":").append(elapsedMillis());
+            json.append('}');
+            return json.toString();
+        }
+
+        private long elapsedMillis() {
+            long end = finishedNanos == 0L ? System.nanoTime() : finishedNanos;
+            long elapsed = end - startedNanos;
+            return elapsed <= 0L ? 0L : elapsed / 1000000L;
+        }
+    }
