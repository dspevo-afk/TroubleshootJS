+    private static final class DescentRun {
+        final Object finalFrame;
+        final String sourceJson;
+        final MetricValue sourceMetrics;
+        final CompactionValue initialControl;
+        final MetricValue finalMetrics;
+        final Vector<StepRecord> steps;
+        final int acceptedSteps;
+        final int evaluatedMoves;
+        final int validatedMoves;
+        final int rejectedMoves;
+        final int compactions;
+        final String status;
+
+        DescentRun(Object finalFrame, String sourceJson, MetricValue sourceMetrics,
+                CompactionValue initialControl, MetricValue finalMetrics,
+                Vector<StepRecord> steps, int acceptedSteps, int evaluatedMoves,
+                int validatedMoves, int rejectedMoves, int compactions,
+                String status) {
+            this.finalFrame = finalFrame;
+            this.sourceJson = sourceJson;
+            this.sourceMetrics = sourceMetrics;
+            this.initialControl = initialControl;
+            this.finalMetrics = finalMetrics;
+            this.steps = steps;
+            this.acceptedSteps = acceptedSteps;
+            this.evaluatedMoves = evaluatedMoves;
+            this.validatedMoves = validatedMoves;
+            this.rejectedMoves = rejectedMoves;
+            this.compactions = compactions;
+            this.status = status;
+        }
+    }
+
+    private static DescentRun runDescent(DescentBackend backend) {
+        Object initialFrame = backend.initialFrame();
+        Object initialSource = backend.source(initialFrame);
+        MetricValue initialMetrics = backend.metrics(initialFrame, true);
+        CompactionValue initialControl = backend.control(initialFrame, initialSource, true);
+        MetricValue finalMetrics = initialMetrics;
+        Object currentFrame = initialFrame;
+        Vector<StepRecord> steps = new Vector<StepRecord>();
+        Vector<Object> retainedSources = new Vector<Object>();
+        int acceptedSteps = 0;
+        int evaluatedMoves = 0;
+        int validatedMoves = 0;
+        int rejectedMoves = 0;
+        int compactions = 0;
+        String status;
+
+        while (true) {
+            backend.check();
+            if (acceptedSteps >= MAX_ACCEPTED_STEPS) {
+                status = "STEP_CAP";
+                break;
+            }
+            if (evaluatedMoves >= MAX_EVALUATED_MOVES) {
+                status = "EVALUATION_CAP";
+                break;
+            }
+            Object stepSource = acceptedSteps == 0 ? initialSource :
+                backend.source(currentFrame);
+            retainedSources.add(stepSource);
+            MetricValue stepMetrics = acceptedSteps == 0 ? initialMetrics :
+                backend.metrics(currentFrame, false);
+            CompactionValue control = acceptedSteps == 0 ? initialControl :
+                backend.control(currentFrame, stepSource, false);
+            StructuralValue structural = backend.structural(currentFrame);
+            StepRecord step = new StepRecord(steps.size() + 1, stepSource,
+                backend.sourceJson(stepSource), stepMetrics, control, structural);
+            if (structural.moves.isEmpty()) {
+                steps.add(step);
+                status = "NO_STRUCTURAL_MOVES";
+                break;
+            }
+
+            boolean accepted = false;
+            boolean evaluationCap = false;
+            for (int index = 0; index < structural.moves.size(); index++) {
+                if (evaluatedMoves >= MAX_EVALUATED_MOVES) {
+                    evaluationCap = true;
+                    break;
+                }
+                backend.check();
+                RowValue row = backend.evaluate(stepSource,
+                    structural.moves.get(index));
+                evaluatedMoves++;
+                if ("PHYSICAL_REJECTED".equals(row.disposition)) {
+                    rejectedMoves++;
+                    step.rows.add(new RowRecord(row, null, false));
+                } else if ("PHYSICAL_VALIDATED".equals(row.disposition)) {
+                    validatedMoves++;
+                    CompactionValue candidate = backend.compact(currentFrame,
+                        stepSource, row);
+                    compactions++;
+                    boolean strict = strictDescentImprovement(candidate.metrics,
+                        stepMetrics, control.metrics, initialMetrics,
+                        initialControl.metrics);
+                    step.rows.add(new RowRecord(row, candidate, strict));
+                    if (strict) {
+                        step.acceptedRowIndex = Integer.valueOf(index);
+                        accepted = true;
+                        acceptedSteps++;
+                        finalMetrics = candidate.metrics;
+                        currentFrame = candidate.nextFrame;
+                        break;
+                    }
+                } else {
+                    throw new IllegalStateException(
+                        "Unknown selected-slide feasibility disposition: " +
+                        row.disposition);
+                }
+            }
+            steps.add(step);
+            if (accepted) {
+                if (acceptedSteps >= MAX_ACCEPTED_STEPS) {
+                    status = "STEP_CAP";
+                    break;
+                }
+                continue;
+            }
+            if (evaluationCap || evaluatedMoves >= MAX_EVALUATED_MOVES) {
+                status = "EVALUATION_CAP";
+                break;
+            }
+            status = "NO_STRICT_IMPROVEMENT";
+            break;
+        }
+
+        for (Object retained : retainedSources) backend.verifySource(retained);
+        MetricValue actualFinal = backend.metrics(currentFrame,
+            currentFrame == initialFrame);
+        require(finalMetrics.same(actualFinal),
+            "final metrics match a fresh final-frame capture");
+        return new DescentRun(currentFrame, backend.sourceJson(initialSource),
+            initialMetrics, initialControl, actualFinal, steps, acceptedSteps,
+            evaluatedMoves, validatedMoves, rejectedMoves, compactions, status);
+    }
+
+    private static boolean strictDescentImprovement(MetricValue candidate,
+            MetricValue currentSource, MetricValue currentControl,
+            MetricValue initialSource, MetricValue initialControl) {
+        return candidate.area < currentSource.area &&
+            candidate.area < currentControl.area &&
+            candidate.area < initialSource.area &&
+            candidate.area < initialControl.area &&
+            candidate.copperLength <= currentSource.copperLength &&
+            candidate.copperLength <= currentControl.copperLength &&
+            candidate.copperLength <= initialSource.copperLength &&
+            candidate.copperLength <= initialControl.copperLength &&
+            candidate.vias <= currentSource.vias &&
+            candidate.vias <= currentControl.vias &&
+            candidate.vias <= initialSource.vias &&
+            candidate.vias <= initialControl.vias &&
+            candidate.largestProtectedEmptyRectangleArea <=
+                currentSource.largestProtectedEmptyRectangleArea &&
+            candidate.largestProtectedEmptyRectangleArea <=
+                currentControl.largestProtectedEmptyRectangleArea &&
+            candidate.largestProtectedEmptyRectangleArea <=
+                initialSource.largestProtectedEmptyRectangleArea &&
+            candidate.largestProtectedEmptyRectangleArea <=
+                initialControl.largestProtectedEmptyRectangleArea;
+    }
