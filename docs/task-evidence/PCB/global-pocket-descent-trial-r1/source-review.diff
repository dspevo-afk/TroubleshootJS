+    /** One canonical pass over movable passive packages using the complete
+     * authoritative placement score. Every proposal keeps the original plan's
+     * geometry except for one rigid package translation. */
+    static Plan relaxMediumGlobalPockets(TroubleshootBoard board,
+            PcbPlacementConstraints constraints,Plan input) {
+        if(board==null || constraints==null || input==null)
+            throw new IllegalArgumentException("Missing medium global-pocket inputs");
+        if(!MediumBoardPhysicalPolicy.selected(constraints) ||
+                constraints.placementDensityVersion!=15 || input.candidate!=2 ||
+                input.evaluations>=MEDIUM_MAX_EVALUATIONS)
+            return input;
+        if(board.getPlacementConstraints()!=constraints)
+            throw new IllegalArgumentException("Medium global-pocket policy differs from board");
+
+        Vector<PcbPlacementConstraints.Part> movable=new Vector<PcbPlacementConstraints.Part>();
+        for(PcbPlacementConstraints.Part part:constraints.getParts()) {
+            PcbFootprint footprint=findPlanFootprint(input.footprints,part.componentId);
+            if(footprint==null)throw new IllegalArgumentException(
+                "Medium global-pocket plan is missing " + part.componentId);
+            String packageId=footprint.getPlacement().getPhysicalPackage().getId();
+            if(part.anchor==PcbPlacementConstraints.Anchor.NONE &&
+                    !footprint.getPlacement().getPhysicalPackage().isConnector() &&
+                    isGlobalPocketPassive(packageId) &&
+                    footprint.getPlacement().getPhysicalGeometry().getIsolationBody()==null)
+                movable.add(part);
+        }
+        if(movable.isEmpty())return input;
+
+        Plan current=input;
+        int evaluations=input.evaluations;
+        MediumBoardPhysicalPolicy.PlacementScore currentScore=
+            MediumBoardPhysicalPolicy.scorePlan(board,current);
+        boolean exhausted=false;
+        for(PcbPlacementConstraints.Part part:movable) {
+            int sourceIndex=findPlanFootprintIndex(current.footprints,part.componentId);
+            if(sourceIndex<0)throw new IllegalArgumentException(
+                "Medium global-pocket plan is missing " + part.componentId);
+            PcbFootprint source=current.footprints.get(sourceIndex);
+            Vector<PcbFootprint> peers=new Vector<PcbFootprint>();
+            for(int index=0;index<current.footprints.size();index++)
+                if(index!=sourceIndex)peers.add(current.footprints.get(index));
+            Rectangle allowed=vacancyDomainBox(source,peers,constraints,current.outline);
+            if(allowed==null)continue;
+
+            Vector<Rectangle> obstacles=new Vector<Rectangle>();
+            for(PcbFootprint peer:peers)obstacles.add(envelope(peer,
+                constraints.get(peer.getPlacement().getComponentId()).accessMargin));
+            Point sourceOrigin=new Point(source.getPlacement().getX(),source.getPlacement().getY());
+            Vector<Point> origins=PcbVacancyTargets.targets(allowed,obstacles,
+                envelope(source,part.accessMargin),sourceOrigin);
+            if(origins.isEmpty())continue;
+
+            Plan best=current;
+            MediumBoardPhysicalPolicy.PlacementScore bestScore=currentScore;
+            Vector<Point> tried=new Vector<Point>();
+            for(Point origin:origins) {
+                int x=mediumGridOrigin(source,origin.x,current.outline,part.accessMargin,false);
+                int y=mediumGridOrigin(source,origin.y,current.outline,part.accessMargin,true);
+                Point snapped=new Point(x,y);
+                if((x==sourceOrigin.x && y==sourceOrigin.y) || containsPoint(tried,snapped))
+                    continue;
+                tried.add(snapped);
+                if(evaluations>=MEDIUM_MAX_EVALUATIONS) { exhausted=true;break; }
+                GenerationWorkScope.check();
+                evaluations++;
+                PcbFootprint moved=source.translated(x,y);
+                if(!fits(moved,current.outline,peers,-1,constraints))continue;
+                Vector<PcbFootprint> trialFootprints=new Vector<PcbFootprint>(current.footprints);
+                trialFootprints.set(sourceIndex,moved);
+                Plan trial=new Plan(current.outline,trialFootprints,current.regions,
+                    current.courtyardArea,current.demandArea,current.candidate,evaluations);
+                MediumBoardPhysicalPolicy.PlacementScore trialScore=
+                    MediumBoardPhysicalPolicy.scorePlan(board,trial);
+                if(trialScore.total>=bestScore.total)continue;
+                try {
+                    validate(board,constraints,trial.outline,trial.footprints);
+                } catch(Rejected rejected) {
+                    continue;
+                }
+                best=trial;
+                bestScore=trialScore;
+            }
+            current=copyPlanWithEvaluations(best,evaluations);
+            currentScore=bestScore;
+            if(exhausted)break;
