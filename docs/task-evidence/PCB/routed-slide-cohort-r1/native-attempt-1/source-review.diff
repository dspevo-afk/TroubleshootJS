+    // BEGIN COPY-ONLY informed routed slide frame adapter.
+    /**
+     * Generic selected-frame admission for the informed cohort.  The
+     * published two-root helper above intentionally keeps its literal frame
+     * guards; this adapter checks only source-declared metadata and the
+     * generation receipt that every informed root actually owns.
+     */
+    static void verifyInformedSelectedFrameForDescent(long seed,
+            TroubleshootBoard board, PcbBoardLayout layout,
+            PcbPlacementPlanner.Plan plan, int attempt,
+            long expectedPlacementSeed, long expectedRoutingSeed) {
+        require(board != null && layout != null && plan != null,
+            "informed selected frame is complete");
+        PcbPlacementConstraints constraints = board.getPlacementConstraints();
+        require(constraints != null && constraints.placementDensityVersion == 14,
+            "informed selected frame retains density14");
+        require(constraints.requiresTwoLayerRouting,
+            "informed selected frame retains the P07 two-layer contract");
+        require(layout.getLayoutAlgorithmVersion() ==
+                SeededPcbLayoutGenerator.CURRENT_VERSION,
+            "informed selected frame retains the current layout algorithm");
+        require(layout.matchesGenerationSeeds(expectedPlacementSeed,
+                expectedRoutingSeed),
+            "informed selected frame retains assigned generation seeds: " + seed);
+        require(layout.getGenerationPlacementAttempts() == 6,
+            "informed selected frame retains six assigned placement attempts");
+        require(layout.getGenerationRoutingAttempts() > 0 &&
+                layout.getGenerationRoutingAttempts() <=
+                    SupportedEnvelope.MAX_ROUTE_ATTEMPTS,
+            "informed selected frame retains bounded assigned routing-order work");
+        require(layout.getGenerationRoutingExpansions() >= 0 &&
+                layout.getGenerationRoutingMillis() >= 0L,
+            "informed selected frame retains assigned routing statistics");
+        require(attempt >= 0 && attempt < 6 && plan.candidate == attempt,
+            "informed selected frame binds selected attempt to source plan candidate");
+        require(plan.courtyardArea >= 0L && plan.demandArea >= 0L &&
+                plan.evaluations > 0,
+            "informed selected frame retains complete plan metadata");
+
+        layout.validateAgainst(board);
+        verifySelectedRegions(board, plan);
+        verifyReframedPlanForDescent(plan, layout);
+        PcbPlacementPlanner.validate(board, constraints, plan.outline, plan.footprints);
+        TreeSet<String> boardComponentIds =
+            new TreeSet<String>(board.getComponentIds());
+        TreeSet<String> boardPadIds = new TreeSet<String>(board.getPadIds());
+        TreeSet<String> layoutComponentIds = new TreeSet<String>();
+        TreeSet<String> layoutPadIds = new TreeSet<String>();
+        for (PcbComponentPlacement component : layout.getComponents()) {
+            GenerationWorkScope.check();
+            require(layoutComponentIds.add(component.getComponentId()) &&
+                    board.getComponent(component.getComponentId()) != null,
+                "informed selected frame has complete component inventory");
+        }
+        for (PcbPadPlacement pad : layout.getPads()) {
+            GenerationWorkScope.check();
+            require(layoutPadIds.add(pad.getPadId()) &&
+                    board.getPad(pad.getPadId()) != null,
+                "informed selected frame has complete pad inventory");
+        }
+        require(layoutComponentIds.equals(boardComponentIds) &&
+                layoutPadIds.equals(boardPadIds),
+            "informed selected frame covers every source component and pad");
+    }
