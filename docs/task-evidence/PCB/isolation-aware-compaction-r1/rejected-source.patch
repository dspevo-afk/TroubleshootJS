+    /** Keep declared conductive-domain clearance before proposing empty strips.
+     * The final validators still decide legality, including escapes and detours.
+     * Earlier interpretations retain their exact all-or-nothing axis behavior. */
+    static void protectIsolationIntervals(PcbPlacementConstraints constraints,
+            Vector<PcbFootprint> parts,boolean xAxis,Vector<int[]> occupied) {
+        if(constraints.placementDensityVersion<12 || constraints.getBarriers().isEmpty())return;
+        TreeMap<String,Rectangle> domains=new TreeMap<String,Rectangle>();
+        for(PcbFootprint part:parts) {
+            TreeMap<String,Rectangle> courtyards=constraints.domainCourtyards(part.getPlacement());
+            for(String domain:courtyards.keySet()) {
+                Rectangle previous=domains.get(domain),next=courtyards.get(domain);
+                domains.put(domain,previous==null?new Rectangle(next):previous.union(next));
+            }
+        }
+        for(PcbPlacementConstraints.Barrier barrier:constraints.getBarriers()) {
+            Rectangle first=domains.get(barrier.firstDomain),second=domains.get(barrier.secondDomain);
+            if(first==null || second==null)continue;
+            long firstStart=xAxis?first.x:first.y,secondStart=xAxis?second.x:second.y;
+            long firstEnd=firstStart+(xAxis?first.width:first.height);
+            long secondEnd=secondStart+(xAxis?second.width:second.height);
+            long start;
+            if(firstEnd+barrier.clearance<=secondStart)start=firstEnd;
+            else if(secondEnd+barrier.clearance<=firstStart)start=secondEnd;
+            else continue; // This axis is not the existing common corridor.
+            occupied.add(new int[]{PcbCoordinateSystem.checkedInt(start),
+                PcbCoordinateSystem.checkedInt(start+barrier.clearance)});
+        }
+    }
