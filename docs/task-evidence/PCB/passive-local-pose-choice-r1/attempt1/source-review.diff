+    private static void considerLocalPoseChoice(Item item,PcbFootprint template,
+            Vector<PcbFootprint> placed,TopologyPlacementGraph topology,
+            TroubleshootBoard board,PcbPlacementConstraints constraints,Rectangle outline,
+            int algorithmCandidate,boolean useCompact,boolean scoreWholeContent,
+            RegionHint hint,Rectangle group,PcbSupportPairPlacement.Pair support,
+            Point vacancyPreference,Rectangle vacancyPocket,int margin,int rawX,int rawY,
+            int[] evaluations,LocalPoseSelection selection) {
+        if(evaluations[0]>=MEDIUM_MAX_EVALUATIONS)
+            throw new Rejected("MEDIUM_PLACEMENT_BUDGET");
+        evaluations[0]++;
+        int x=mediumGridOrigin(template,rawX,outline,margin,false);
+        int y=mediumGridOrigin(template,rawY,outline,margin,true);
+        PcbFootprint trial=template.translated(x,y);
+        boolean fitsTrial=fits(trial,outline,placed,-1,constraints);
+        if(!fitsTrial) {
+            if(selection.observer!=null)selection.observer.evaluated(rawX,rawY,x,y,
+                template.getPlacement().getRotation(),false,Double.NaN);
+            return;
+        }
+        double score=mediumPlacementScore(trial,item,placed,topology,board,hint,outline,
+            useCompact,scoreWholeContent,group);
+        if(support!=null)score+=support.endpointSpan(trial)*3.0;
+        if(vacancyPreference!=null)score+=(Math.abs((long)x-vacancyPreference.x)+
+            Math.abs((long)y-vacancyPreference.y))*.25;
+        if(vacancyPocket!=null)score-=vacancyOverlapArea(envelope(trial,item.demand.accessMargin),
+            vacancyPocket)/(double)MEDIUM_STEP;
+        if(selection.observer!=null)selection.observer.evaluated(rawX,rawY,x,y,
+            template.getPlacement().getRotation(),true,score);
+        if(score<selection.bestScore) {
+            selection.best=trial;
+            selection.bestScore=score;
+        }
+    }
