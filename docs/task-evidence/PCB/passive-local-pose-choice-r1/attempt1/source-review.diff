+    private static PcbFootprint mediumPlaceLocalPoseChoice(Item item,
+            Vector<PcbFootprint> placed,TopologyPlacementGraph topology,
+            TroubleshootBoard board,PcbPlacementConstraints constraints,Rectangle outline,
+            long seed,int algorithmCandidate,boolean useCompact,boolean scoreWholeContent,
+            boolean anchor,PcbPlacementConstraints.Anchor side,int preferredX,int baseX,int baseY,
+            int direction,RegionHint hint,Rectangle group,PcbSupportPairPlacement.Pair support,
+            Vector<Point> vacancies,Point vacancyPreference,Rectangle vacancyPocket,
+            int[] evaluations) {
+        LocalPoseSelection selection=new LocalPoseSelection();
+        PcbFootprint source=item.footprint,alternative=item.passivePoseAlternative;
+        int maxRing=anchor?24:20;
+        int margin=itemsMargin(item,constraints);
+        for(int ring=0;ring<=maxRing;ring++) {
+            int step=ring*MEDIUM_STEP;
+            int[] dx=anchor?new int[]{0,0,0,0,0}:new int[]{direction*step,-direction*step,0,0,
+                direction*step,-direction*step};
+            int[] dy=anchor?new int[]{0,step,-step,step*2,-step*2}:
+                new int[]{0,0,step,-step,step,-step};
+            int count=Math.min(dx.length,dy.length);
+            for(int index=0;index<count;index++) {
+                int x=anchor?preferredX:baseX+dx[index];
+                int y=baseY+dy[index];
+                if(ring==0 && index>0 && vacancies!=null && index<=vacancies.size()) {
+                    Point vacancy=vacancies.get(index-1);x=vacancy.x;y=vacancy.y;
+                }
+                if(anchor && side==PcbPlacementConstraints.Anchor.RIGHT)x=preferredX;
+                considerLocalPoseChoice(item,source,placed,topology,board,constraints,outline,
+                    algorithmCandidate,useCompact,scoreWholeContent,hint,group,support,
+                    vacancyPreference,vacancyPocket,margin,x,y,evaluations,selection);
+                considerLocalPoseChoice(item,alternative,placed,topology,board,constraints,outline,
+                    algorithmCandidate,useCompact,scoreWholeContent,hint,group,support,
+                    vacancyPreference,vacancyPocket,margin,x,y,evaluations,selection);
+            }
+        }
+        if(selection.best==null) {
+            int minX=mediumGridBound(source,outline,margin,false,false);
+            int maxX=mediumGridBound(source,outline,margin,false,true);
+            int minY=mediumGridBound(source,outline,margin,true,false);
+            int maxY=mediumGridBound(source,outline,margin,true,true);
+            int columns=Math.max(1,(maxX-minX)/MEDIUM_STEP+1);
+            int rows=Math.max(1,(maxY-minY)/MEDIUM_STEP+1);
+            long total=(long)columns*rows;
+            long hash=item.demand.componentId.hashCode()^(seed*0x9e3779b97f4a7c15L)^
+                (long)(algorithmCandidate+1)*0x632be59bd9b4e019L;
+            int start=(int)((hash^(hash>>>32))&0x7fffffffL);
+            if(total>0)start=(int)(start%total);
+            for(long visit=0;visit<total;visit++) {
+                int index=(int)((start+visit)%total);
+                int row=index/columns,col=index%columns;
+                if((row&1)!=0)col=columns-1-col;
+                int x=minX+col*MEDIUM_STEP,y=minY+row*MEDIUM_STEP;
+                considerLocalPoseChoice(item,source,placed,topology,board,constraints,outline,
+                    algorithmCandidate,useCompact,scoreWholeContent,hint,group,support,
+                    vacancyPreference,vacancyPocket,margin,x,y,evaluations,selection);
+                considerLocalPoseChoice(item,alternative,placed,topology,board,constraints,outline,
+                    algorithmCandidate,useCompact,scoreWholeContent,hint,group,support,
+                    vacancyPreference,vacancyPocket,margin,x,y,evaluations,selection);
+                if(selection.best!=null)break;
+            }
+        }
+        return selection.best;
+    }
