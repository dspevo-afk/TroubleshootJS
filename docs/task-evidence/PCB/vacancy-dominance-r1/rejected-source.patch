+    /** A vacancy must improve one local cost without worsening the other. */
+    static boolean vacancyDominates(double proposedWire,long proposedArea,
+            double originalWire,long originalArea) {
+        if(Double.isNaN(proposedWire)||Double.isInfinite(proposedWire)||proposedWire<0 ||
+                Double.isNaN(originalWire)||Double.isInfinite(originalWire)||originalWire<0 ||
+                proposedArea<=0 || originalArea<=0)
+            throw new IllegalArgumentException("Invalid vacancy dominance costs");
+        return proposedWire<=originalWire && proposedArea<=originalArea &&
+            (proposedWire<originalWire || proposedArea<originalArea);
+    }
+
+    private static double mediumPadDistance(PcbFootprint footprint,Item item,
+            Vector<PcbFootprint> placed,TopologyPlacementGraph topology,TroubleshootBoard board) {
+        double distance=0;
+        for(TopologyPlacementGraph.PadLink link:topology.getLinksFor(item.demand.componentId)) {
+            PcbFootprint other=findPlacedFootprint(placed,link.getOtherComponentId());
+            if(other==null)continue;
+            PcbPadPlacement a=footprint.getPad(link.getPadId()),b=other.getPad(link.getOtherPadId());
+            distance+=(Math.abs((long)a.getX()-b.getX())+Math.abs((long)a.getY()-b.getY()))*
+                mediumLinkWeight(board,link);
+        }
+        return distance;
+    }
+
+    private static long mediumOccupiedArea(PcbFootprint footprint,Vector<PcbFootprint> placed) {
+        Rectangle occupied=footprint.getPlacement().getRoutingCourtyard();
+        for(PcbFootprint other:placed)
+            if(!other.getPlacement().getPhysicalPackage().isConnector())
+                occupied=union(occupied,other.getPlacement().getRoutingCourtyard());
+        return (long)occupied.width*occupied.height;
+    }
